{
  "name": "visual_to_steering_v0",
  "dataset": "MaleCNS v1.0",
  "data": {
    "annotations": "../../../support/body-annotations-male-cns-v1.0-minconf-0.5.feather",
    "neurotransmitters": "../../../support/body-neurotransmitters-male-cns-v1.0.feather",
    "connectivity": "../../../support/connectome-weights-male-cns-v1.0-minconf-0.5.feather"
  },
  "selectors": {
    "inputs": [{"field": "type", "regex": "^LC10a$", "label": "LC10a visual projection"}],
    "relays": [
      {"field": "type", "regex": "^AOTU019$", "label": "AOTU019 steering relay"},
      {"field": "type", "regex": "^AOTU025$", "label": "AOTU025 steering relay"}
    ],
    "outputs": [{"field": "type", "regex": "^DNa02$", "label": "DNa02 descending steering output"}]
  },
  "annotation_filters": {
    "include": [{"field": "type", "regex": "^(?:LC10a|AOTU019|AOTU025|DNa02)$"}],
    "exclude": []
  },
  "extraction": {"max_hops": 2, "min_synapse_count": 5, "batch_rows": 2000000, "max_frontier_nodes": 250000},
  "ir": {"neuron_record_bits": 64, "synapse_record_bits": 64, "offset_entry_bits": 32, "bram36_bits": 36864}
}
