{
  "name": "courtship_song_v0",
  "dataset": "MaleCNS v1.0",
  "data": {
    "annotations": "../../../support/body-annotations-male-cns-v1.0-minconf-0.5.feather",
    "neurotransmitters": "../../../support/body-neurotransmitters-male-cns-v1.0.feather",
    "connectivity": "../../../support/connectome-weights-male-cns-v1.0-minconf-0.5.feather"
  },
  "selectors": {
    "inputs": [
      {"field": "type", "regex": "^JO-(?:A|B)", "label": "Johnston organ auditory neurons"}
    ],
    "relays": [
      {"field": "synonyms", "regex": "Vaughan 2014: aPN1", "label": "aPN1 auditory relay (MaleCNS literature alias)"},
      {"field": "synonyms", "regex": "Zhou 2015: vPN1", "label": "vPN1 auditory relay (MaleCNS literature alias)"},
      {"field": "type", "regex": "^pC1", "label": "pC1 courtship integration"}
    ],
    "outputs": [
      {"field": "type", "regex": "^pIP10$", "label": "pIP10 descending output"},
      {"field": "type", "regex": "^pMP2$", "label": "pMP2 descending output"}
    ]
  },
  "annotation_filters": {
    "include": [],
    "exclude": []
  },
  "extraction": {
    "max_hops": 4,
    "min_synapse_count": 5,
    "batch_rows": 2000000,
    "max_frontier_nodes": 250000
  },
  "ir": {
    "neuron_record_bits": 64,
    "synapse_record_bits": 64,
    "offset_entry_bits": 32,
    "bram36_bits": 36864
  }
}
